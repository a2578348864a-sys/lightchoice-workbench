# ── 运行模式 / 数据库 ─────────────────────────────────────────────
# 本地单用户（Local Owner）；不要暴露到公网
QX_RUNTIME_MODE=local_owner
DATABASE_URL="file:./dev.db"

# 证据库根目录（append-only；默认 ./data/source-layer-store）
SOURCE_LAYER_STORE_DIR=./data/source-layer-store

# ── AI（研究辅助）────────────────────────────────────────────────
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 单次调用超时（毫秒）
AI_TIMEOUT_MS=60000
# 研报输出预算；长报告可按需调大
AI_RESEARCH_MAX_TOKENS=2000

# 签名密钥（本地开发有内置默认值；正式使用请改成随机值）
PROOF_SIGNING_SECRET=replace_with_a_separate_random_server_secret

# ── 采集（默认关闭，需显式开启）──────────────────────────────────
# 关闭时不会发起任何真实采集；开启后需要本机浏览器 Profile
LOCAL_ACQUISITION_ENABLED=false
V5_ACQUISITION_SCOPE=single_asin_only
# Amazon 采集 Profile（含登录态，按凭据保护）
AMAZON_CAPTURE_PROFILE_DIR=
# 如需代理（例如本机 7890），填写 http://127.0.0.1:7890
AMAZON_CAPTURE_PROXY_URL=
# SellerSprite 采集通过本机 CDP 浏览器
SELLERSPRITE_CDP_ENDPOINT=http://127.0.0.1:9222

# ── 飞书（可选，不影响本地主链）──────────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_APP_TOKEN=
FEISHU_RESEARCH_TABLE_ID=
FEISHU_MARKET_TABLE_ID=
